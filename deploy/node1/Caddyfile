# Server 2: sits behind punkto.xyz and test1
# Caddy auto-HTTPS via Let's Encrypt

# ── Reusable relay+static body. Root NOT set here; each site sets its own `root`
#    immediately after importing so the correct static tree is served. ─────────
(punkto_relay) {
    file_server

    # Punkti v0.5.1 canonical atom store API (World data source)
    @atoms_paths path /atoms /atoms/* /atoms/v1 /atoms/v1/* /atoms/v1/mid/* /atoms/v1/feed /atoms/v1/sync /atoms/v1/info /atoms/v1/health
    reverse_proxy @atoms_paths atoms:8020

    # API / relay endpoints — proxy to relay container
    @relay_paths path /atom /atom/* /latest /stream /feed /health /info /status /node/info /node/info/* \
        /llms.txt /robots.txt /sitemap.xml /openapi.json \
        /punkto.ai.md /punkto.md /punkto.node.md /punkto.sync.md \
        /punkto.manifest.md /punkto.identity.md /punkto.ui.md \
        /.well-known/*
    reverse_proxy @relay_paths relay:8000

    # Pattern-based relay paths
    @relay_patterns path_regexp relay ^/(punkto(/.*)?|p/.+)$
    reverse_proxy @relay_patterns relay:8000

    # CORS headers on relay responses
    @is_relay {
        path /atom /atom/* /latest /stream /feed /health /info /status /node/info /node/info/*
        path /atoms /atoms/* /atoms/v1 /atoms/v1/*
        path /punkto* /p/*
    }
    header @is_relay Access-Control-Allow-Origin "*"
    header @is_relay Access-Control-Allow-Methods "GET, POST, OPTIONS"
    header @is_relay Access-Control-Allow-Headers "Content-Type, Authorization"

    # Service worker — never cache
    @sw path /sw.js
    header @sw Cache-Control "no-cache, no-store, must-revalidate"
    header @sw Pragma "no-cache"
    header @sw Expires "0"

    # App shell — never cache (all root-level JS + HTML)
    @app {
        not path /lib/*
        path *.html *.js
    }
    header @app Cache-Control "no-cache, no-store, must-revalidate"
    header @app Pragma "no-cache"
    header @app Expires "0"

    # Static libs — long cache
    @static_libs path /lib/*
    header @static_libs Cache-Control "public, max-age=86400, immutable"

    # Security headers
    header {
        X-Content-Type-Options  nosniff
        X-Frame-Options         DENY
        Referrer-Policy         strict-origin-when-cross-origin
        -Server
    }

    encode gzip

    log {
        output stderr
        format console
        level INFO
    }
}

# ── Punkto 1.0 — World v1.0 flagship experience ──────────────────────────────
punkto.xyz {
    root * /srv-punkto-v1
    import punkto_relay
}

www.punkto.xyz {
    redir https://punkto.xyz{uri} permanent
}

# ── Explorer — preserved legacy Punkto client ────────────────────────────────
explorer.punkto.xyz {
    root * /srv-punkto-explorer
    import punkto_relay
}

# ── Technical node hosts — legacy PWA from image ─────────────────────────────
app1.punkto.xyz {
    root * /srv
    import punkto_relay
}

node1.punkto.xyz {
    root * /srv
    import punkto_relay
}

# ── test1 — Punkto World staging (real atom source) ──────────────────────────
test1.punkto.xyz {
    root * /srv-punkto-world
    @atoms_paths path /atoms /atoms/* /atoms/v1 /atoms/v1/*
    reverse_proxy @atoms_paths atoms:8020
    file_server
    encode gzip
    log {
        output stderr
        format console
        level INFO
    }
}
